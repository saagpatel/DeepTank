# DeepTank command governance rules.
# Most restrictive decision wins: forbidden > prompt > allow.

# Project commands may execute arbitrary repo code, so they remain sandboxed or
# require an explicit prompt when outside the sandbox.
prefix_rule(
    pattern = ["npm", "run"],
    decision = "prompt",
    justification = "Project scripts are canonical but may execute arbitrary repo code.",
)

prefix_rule(
    pattern = ["npm", "exec"],
    decision = "prompt",
    justification = "npm exec may download or execute project-local tooling.",
)

prefix_rule(
    pattern = ["node"],
    decision = "prompt",
    justification = "Node scripts remain inside the sandbox unless explicitly approved.",
)

prefix_rule(
    pattern = ["cargo", "test"],
    decision = "prompt",
    justification = "Rust tests execute repo code and should not escape the sandbox silently.",
)

# Potentially destructive commands require prompt or are blocked.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push operations require explicit review.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "Never push directly to main.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard resets can destroy local work.",
)

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Catastrophic filesystem deletion is always blocked.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not elevate privileges from agent sessions.",
)
